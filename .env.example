# Guest mode works with no environment variables.
# Configure OAuth before advertising account sync. Do not commit real secrets.
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Provider redirect: {BETTER_AUTH_URL}/api/auth/callback/google (or /github)
# The local Node deployment uses .data/pmforge.sqlite. Cloudflare D1 needs its adapter.
PMFORGE_DATABASE_PATH=

# Optional interview speech. Server-only keys; typing/browser voice need no keys.
PMFORGE_VOICE_ENABLED=false
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional stable signing secret for portfolio links. Without one, a persistent
# random secret is generated in the application SQLite database. Server-only.
PMFORGE_SHARE_SECRET=

# Email signup, verification and password recovery. Server-only.
AUTH_EMAIL_FROM=
# Optional durable support inbox. Leave empty until one is owned and monitored.
AUTH_EMAIL_REPLY_TO=
RESEND_API_KEY=
# Local development only: set AUTH_EMAIL_MODE=preview and a local auth secret.
# Emails are written privately beside the configured database, not sent.
AUTH_EMAIL_MODE=
SITE_URL=http://localhost:3002
# A reverse proxy must overwrite this header; do not expose the app port.
AUTH_TRUSTED_IP_HEADER=x-pmforge-client-ip

# AI interview — guided is the $0 default; a key alone never enables inference.
PMFORGE_AI_MODE=guided
GEMINI_API_KEY=
PMFORGE_AI_MODEL=gemini-3.1-flash-lite
PMFORGE_AI_TRANSPORT=generate-content
PMFORGE_AI_TIMEOUT_MS=20000
PMFORGE_AI_MAX_TURNS=10
PMFORGE_AI_TIMEBOX_SECONDS=720
PMFORGE_AI_DAILY_SESSIONS_PER_USER=2
PMFORGE_AI_MAX_CONCURRENT_SESSIONS=2
PMFORGE_AI_MONTHLY_BUDGET_USD=0
PMFORGE_AI_KILL_SWITCH=false
# Copy actual project limits from AI Studio. Zero keeps external admission closed.
PMFORGE_AI_PROJECT_RPM=0
PMFORGE_AI_PROJECT_TPM=0
PMFORGE_AI_PROJECT_RPD=0
PMFORGE_AI_FREE_TIER_VERIFIED=false
PMFORGE_AI_TERMS_APPROVED=false
# Comma-separated ISO region codes approved against current provider terms.
PMFORGE_AI_ALLOWED_REGIONS=
PMFORGE_AI_PERSONAL_DATA_APPROVED=false
# Explicit production-only prices, USD per million tokens (including reasoning).
PMFORGE_AI_INPUT_USD_PER_MILLION=0
PMFORGE_AI_OUTPUT_USD_PER_MILLION=0
# Paid speech stays off even when legacy keys exist.
PMFORGE_PAID_SPEECH_APPROVED=false
PMFORGE_VOICE_MONTHLY_BUDGET_USD=0

# Paid mode only: verified maximum billed output including reasoning tokens; 0 blocks production AI.
PMFORGE_AI_BILLABLE_OUTPUT_TOKEN_RESERVE=0

# Local review only; public deployments must leave this false.
PMFORGE_AI_LOCAL_TEST=false
