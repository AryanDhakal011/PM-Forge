{
  "name": "pmforge",
  "version": "1.0.0",
  "private": true,
  "description": "PMForge — a practice platform for product decisions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "launch:check": "node --env-file-if-exists=.env.local scripts/check-launch.mjs",
    "test": "node --import tsx --test tests/interview-engine.test.ts tests/calibration.test.ts tests/projects.test.ts && node --conditions=react-server --import tsx --test tests/account-server.test.ts",
    "test:deadlock": "node --import tsx --test tests/deadlock.test.ts tests/deadlock-v2.test.ts tests/deadlock-refinements.test.ts",
    "deadlock:sim": "node --import tsx scripts/deadlock-sim.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.14",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.182.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
