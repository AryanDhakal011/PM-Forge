# Copy to .env.production. Do not commit the filled file.
PMFORGE_DOMAIN=practice.example.com
SITE_URL=https://practice.example.com
BETTER_AUTH_URL=https://practice.example.com
BETTER_AUTH_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Verified sender + server-only Resend key enable signup/verification/recovery.
AUTH_EMAIL_FROM=PMForge <accounts@example.com>
RESEND_API_KEY=
# Optional OAuth credentials. Configure callback URLs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stable signing key; leave empty to use the persistent database-generated key.
PMFORGE_SHARE_SECRET=
PMFORGE_VOICE_ENABLED=false
