{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-platform/types/**/*.ts",
    ".next-platform/dev/types/**/*.ts",
    ".next-pivot/types/**/*.ts",
    ".next-pivot/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-auth/types/**/*.ts",
    ".next-auth/dev/types/**/*.ts",
    ".next-ai/types/**/*.ts",
    ".next-ai/dev/types/**/*.ts",
    ".next-development/types/**/*.ts",
    ".next-development/dev/types/**/*.ts"
  ],
  "exclude": [
    "services/hot-seat-agent",
    "node_modules"
  ]
}
